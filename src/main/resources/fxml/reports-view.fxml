<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.erpdemo.controller.ReportsController"
            stylesheets="@../css/reports.css">

    <center>
        <VBox spacing="18" alignment="TOP_LEFT" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <!-- Başlıklar -->
            <VBox spacing="6">
                <Label text="Raporlar" styleClass="page-title"/>
                <Label text="Onaylanmış Talepler — PDF / Excel" styleClass="page-subtitle"/>
            </VBox>

            <Separator/>

            <!-- İçerik kartları: PDF | Excel -->
            <GridPane hgap="18" vgap="18">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                </columnConstraints>

                <!-- PDF Kartı -->
                <VBox GridPane.columnIndex="0" spacing="12" styleClass="card">
                    <Label text="Satışlar PDF" styleClass="card-title"/>
                    <Label text="Seçili dönem için PDF raporu oluşturur." styleClass="muted"/>
                    <TilePane hgap="10" vgap="10" prefColumns="3">
                        <Button text="Bugün"        onAction="#generateApprovedRequestsToday"        maxWidth="1.7976931348623157E308" styleClass="pill"/>
                        <Button text="Bu Hafta"     onAction="#generateApprovedRequestsThisWeek"     maxWidth="1.7976931348623157E308" styleClass="pill"/>
                        <Button text="Bu Ay"        onAction="#generateApprovedRequestsThisMonth"    maxWidth="1.7976931348623157E308" styleClass="pill"/>
                        <Button text="Son 1 Ay"     onAction="#generateApprovedRequestsRollingMonth" maxWidth="1.7976931348623157E308" styleClass="pill"/>
                        <Button text="Tüm Zamanlar" onAction="#generateApprovedRequestsAllTime"      maxWidth="1.7976931348623157E308" styleClass="pill"/>
                    </TilePane>
                </VBox>

                <!-- Excel Kartı -->
                <VBox GridPane.columnIndex="1" spacing="12" styleClass="card">
                    <Label text="Satışlar Excel" styleClass="card-title"/>
                    <Label text="Seçili dönem için XLSX dosyası oluşturur." styleClass="muted"/>
                    <TilePane hgap="10" vgap="10" prefColumns="3">
                        <Button text="Bugün"        onAction="#exportApprovedRequestsTodayExcel"        maxWidth="1.7976931348623157E308" styleClass="pill"/>
                        <Button text="Bu Hafta"     onAction="#exportApprovedRequestsThisWeekExcel"     maxWidth="1.7976931348623157E308" styleClass="pill"/>
                        <Button text="Bu Ay"        onAction="#exportApprovedRequestsThisMonthExcel"    maxWidth="1.7976931348623157E308" styleClass="pill"/>
                        <Button text="Son 1 Ay"     onAction="#exportApprovedRequestsRollingMonthExcel" maxWidth="1.7976931348623157E308" styleClass="pill"/>
                        <Button text="Tüm Zamanlar" onAction="#exportApprovedRequestsAllTimeExcel"      maxWidth="1.7976931348623157E308" styleClass="pill"/>
                    </TilePane>
                </VBox>
            </GridPane>
        </VBox>
    </center>

</BorderPane>
