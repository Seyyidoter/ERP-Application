<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.erpdemo.ProfileController" spacing="12" style="-fx-padding: 16;">
    <Label text="Profil" style="-fx-font-size:20; -fx-font-weight:bold;"/>

    <GridPane hgap="10" vgap="8">
        <columnConstraints>
            <ColumnConstraints minWidth="120"/>
            <ColumnConstraints minWidth="220"/>
        </columnConstraints>
        <children>
            <Label text="Kullanıcı Adı:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label fx:id="lblUsername" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Rol:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label fx:id="lblRole" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        </children>
    </GridPane>

    <Separator/>

    <Label text="Şifre Değiştir" style="-fx-font-weight:700;"/>
    <GridPane hgap="10" vgap="8">
        <columnConstraints>
            <ColumnConstraints minWidth="120"/>
            <ColumnConstraints minWidth="220"/>
        </columnConstraints>
        <children>
            <Label text="Mevcut Şifre" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <PasswordField fx:id="txtCurrent" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Yeni Şifre" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <PasswordField fx:id="txtNew" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Yeni Şifre (Tekrar)" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <PasswordField fx:id="txtNew2" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        </children>
    </GridPane>

    <HBox spacing="8" alignment="CENTER_RIGHT">
        <Button text="Kaydet" onAction="#handleChangePassword"/>
        <Button text="Kapat"  onAction="#handleClose"/>
    </HBox>
</VBox>
