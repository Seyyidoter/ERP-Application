<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.erpdemo.ReportsController">

    <center>
        <VBox spacing="12" alignment="TOP_LEFT" BorderPane.alignment="CENTER">
            <padding>
                <Insets topRightBottomLeft="24"/>
            </padding>

            <Label text="Raporlar" style="-fx-font-size: 28; -fx-font-weight: bold;"/>
            <Label text="Onaylanmış Talepler PDF" style="-fx-font-size: 16; -fx-opacity: 0.85;"/>

            <!-- Dönem bazlı PDF üretim butonları -->
            <HBox spacing="12">
                <Button text="Bugün"        onAction="#generateApprovedRequestsToday"/>
                <Button text="Bu Hafta"     onAction="#generateApprovedRequestsThisWeek"/>
                <Button text="Bu Ay"        onAction="#generateApprovedRequestsThisMonth"/>
                <Button text="Son 1 Ay"     onAction="#generateApprovedRequestsRollingMonth"/>
                <Button text="Tüm Zamanlar" onAction="#generateApprovedRequestsAllTime"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>
