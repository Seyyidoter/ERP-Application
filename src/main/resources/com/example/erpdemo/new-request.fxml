<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.erpdemo.NewRequestController">

    <!-- Kenar boşlukları DOĞRU kullanım -->
    <padding>
        <Insets topRightBottomLeft="12"/>
    </padding>

    <top>
        <VBox spacing="10">
            <children>
                <GridPane hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="30"/>
                        <ColumnConstraints percentWidth="70"/>
                    </columnConstraints>

                    <children>
                        <Label text="Müşteri" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="customerComboBox" promptText="Müşteri seçin"
                                  GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Ürün" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="productComboBox" promptText="Ürün seçin"
                                  GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Miktar" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="quantityField" promptText="Adet"
                                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    </children>
                </GridPane>

                <HBox spacing="8" alignment="CENTER_RIGHT">
                    <Button text="Ürün Ekle" onAction="#handleAddProduct"/>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <TableView fx:id="productTable">
            <placeholder>
                <Label text="Eklenmiş ürün yok."/>
            </placeholder>
            <columns>
                <TableColumn fx:id="productNameColumn" text="Ürün" prefWidth="240"/>
                <TableColumn fx:id="quantityColumn" text="Miktar" prefWidth="100"/>
                <TableColumn fx:id="priceColumn" text="Liste Fiyatı" prefWidth="120"/>
                <TableColumn fx:id="discountedPriceColumn" text="İskontolu Fiyat" prefWidth="140"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="10">
            <children>
                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Label text="Toplam:"/>
                    <Label fx:id="totalAmountLabel" text="0.00 TL"/>
                </HBox>

                <HBox alignment="CENTER_RIGHT" spacing="8">
                    <Button text="Kaydet" onAction="#handleSaveRequest"/>
                    <Button text="İptal"  onAction="#handleCancel"/>
                </HBox>
            </children>
        </VBox>
    </bottom>
</BorderPane>
