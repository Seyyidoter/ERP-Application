<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.erpdemo.RequestController">

    <padding>
        <Insets topRightBottomLeft="12"/>
    </padding>

    <center>
        <TableView fx:id="tblRequests" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="colId"              text="ID"            prefWidth="90.0"/>
                <TableColumn fx:id="colCustomer"        text="Müşteri ID"    prefWidth="110.0"/>
                <TableColumn fx:id="colCustomerName"    text="Müşteri Adı"   prefWidth="240.0"/>
                <TableColumn fx:id="colDate"            text="Talep Tarihi"  prefWidth="160.0"/>
                <TableColumn fx:id="colStatus"          text="Durum"         prefWidth="180.0"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="8">
            <padding><Insets topRightBottomLeft="8"/></padding>
            <Button text="Yeni Talep Oluştur" onAction="#createRequest"/>
            <Button text="Talebi Görüntüle"   onAction="#viewRequest"/>
            <Button text="Talebi Sil"         onAction="#deleteSingleRequest"/>
        </HBox>
    </bottom>
</BorderPane>
