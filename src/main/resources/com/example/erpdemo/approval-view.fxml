<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.erpdemo.ApprovalController"
      spacing="10.0" style="-fx-padding: 20;">
    <children>
        <Label text="Onay İşlemleri">
            <font><Font name="System Bold" size="24.0"/></font>
        </Label>

        <TableView fx:id="pendingRequestsTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idColumn"            prefWidth="80.0"  text="Talep ID"/>
                <TableColumn fx:id="customerIdColumn"    prefWidth="100.0" text="Müşteri ID"/>
                <TableColumn fx:id="customerNameColumn"  prefWidth="220.0" text="Müşteri Adı"/>
                <TableColumn fx:id="dateColumn"          prefWidth="150.0" text="Talep Tarihi"/>
                <TableColumn fx:id="statusColumn"        prefWidth="200.0" text="Durum"/>
            </columns>
        </TableView>

        <!-- BUTON BARI: tablo dışı tıklama filtresinde hariç tutulması için fx:id eklendi -->
        <HBox fx:id="actionsBar" spacing="10.0" alignment="CENTER_RIGHT">
            <children>
                <Button fx:id="viewBtn"    text="Görüntüle" onAction="#handleView"/>
                <Button fx:id="approveBtn" text="Onayla"    onAction="#handleApprove"/>
                <Button fx:id="rejectBtn"  text="Reddet"    onAction="#handleReject"/>
            </children>
        </HBox>
    </children>
</VBox>
