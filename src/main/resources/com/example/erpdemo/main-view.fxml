<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.erpdemo.MainController"
            stylesheets="@main-view.css">

    <!-- ÜST: App Bar -->
    <top>
        <HBox styleClass="appbar" alignment="CENTER_LEFT" spacing="14">
            <Label fx:id="pageTitle" text="Gösterge Paneli" styleClass="appbar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="?" onAction="#openHelp" styleClass="icon-btn" />
            <!-- Rolü burada göstereceğiz -->
            <MenuButton fx:id="userMenu" text="Kullanıcı" styleClass="user-menu">
                <items>
                    <MenuItem text="Profil"/>
                    <MenuItem text="Ayarlar"/>
                    <MenuItem text="Çıkış" onAction="#logout"/>
                </items>
            </MenuButton>
        </HBox>
    </top>

    <!-- SOL: Sidebar -->
    <left>
        <VBox styleClass="sidebar" spacing="8">
            <Separator/>

            <Button text="Gösterge Paneli"    onAction="#goDashboard" styleClass="nav-btn"/>
            <Button text="Müşteri İşlemleri"   onAction="#goCustomers" styleClass="nav-btn"/>
            <Button text="Talep/Teklif"        onAction="#goRequests"  styleClass="nav-btn"/>
            <Button text="Onay İşlemleri"      onAction="#goApprovals" styleClass="nav-btn"/>
            <Button text="Raporlar"            onAction="#goReports"   styleClass="nav-btn"/>

            <Region VBox.vgrow="ALWAYS"/>
            <Label text="v1.0.0" styleClass="sidebar-foot"/>
        </VBox>
    </left>

    <!-- ORTA: İçerik -->
    <center>
        <StackPane fx:id="contentRoot" styleClass="content-root">
            <VBox alignment="CENTER" spacing="18">
                <Label text="Gösterge Paneli" styleClass="hero-title"/>
                <HBox spacing="14" alignment="CENTER">
                    <VBox styleClass="card">
                        <Label text="Toplam Müşteri" styleClass="card-title"/>
                        <Label text="128" styleClass="card-metric"/>
                    </VBox>
                    <VBox styleClass="card">
                        <Label text="Bekleyen Onay" styleClass="card-title"/>
                        <Label text="6" styleClass="card-metric"/>
                    </VBox>
                    <VBox styleClass="card">
                        <Label text="Stok Uyarısı" styleClass="card-title"/>
                        <Label text="3" styleClass="card-metric warning"/>
                    </VBox>
                </HBox>
            </VBox>
        </StackPane>
    </center>

</BorderPane>
